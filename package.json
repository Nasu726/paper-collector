{
  "name": "paper-collector",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "build": "npm run typecheck && vite build",
    "test:openalex": "tsx ./scripts/test-openalex.ts",
    "test:crossref": "tsx ./scripts/test-crossref.ts",
    "test:recommendation": "tsx ./scripts/test-recommendation.ts",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=./seed/development.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "db:smoke:local": "wrangler d1 execute DB --local --command=\"SELECT (SELECT COUNT(*) FROM feeds) AS feeds, (SELECT COUNT(*) FROM papers) AS papers, (SELECT COUNT(*) FROM paper_feeds) AS memberships\"",
    "api:smoke:local": "node ./scripts/smoke-worker.mjs",
    "api:smoke:feedback": "node ./scripts/smoke-feedback.mjs",
    "api:smoke:recommendation": "node ./scripts/smoke-recommendation.mjs",
    "api:smoke:ingestion": "node ./scripts/smoke-ingestion.mjs",
    "api:smoke:feed-lifecycle": "node ./scripts/smoke-feed-lifecycle.mjs",
    "api:smoke:multifeed": "node ./scripts/smoke-multifeed-lifecycle.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260906.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "4.23.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "wrangler": "4.129.0"
  }
}
