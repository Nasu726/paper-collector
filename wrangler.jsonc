{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paper-collector",
  "compatibility_date": "2026-09-06",
  "main": "./worker/entry.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // Paper Collector and book-reader intentionally share one physical D1.
      // Each application owns non-overlapping tables and keeps an independent
      // Wrangler migration history so similarly numbered migration files cannot collide.
      "database_name": "book-reader",
      "database_id": "c0ed3894-0dbf-4de3-b151-2bf35396d577",
      "migrations_table": "paper_collector_migrations",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  }
}
